<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>BitwardenStreamdeckPlugin</RootNamespace>
    <AssemblyName>com.thejoeiaut.bitwarden</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Bitwarden Stream Deck Plugin</Product>
    <AssemblyTitle>Bitwarden Stream Deck Plugin</AssemblyTitle>
    <Company>TheJoeIaut</Company>
    <Copyright>Copyright © TheJoeIaut</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\com.thejoeiaut.bitwarden.sdPlugin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\com.thejoeiaut.bitwarden.sdPlugin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="H.InputSimulator" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamDeck-Tools" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="previews\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="PropertyInspector\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- StreamDeck-Tools 7 pulls in SkiaSharp, whose native assets add ~240 MB of debug
       symbols (one libSkiaSharp.pdb per RID) plus a macOS dylib. This plugin is
       Windows-only, so keep them out of the .sdPlugin folder we ship. Build and publish
       use separate item lists, so both need filtering. -->
  <Target Name="RemoveUnusedSkiaNativeAssetsOnBuild" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'libSkiaSharp' And ('%(Extension)' == '.pdb' Or '%(Extension)' == '.dylib' Or '%(Extension)' == '.so')" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedSkiaNativeAssetsOnPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'libSkiaSharp' And ('%(Extension)' == '.pdb' Or '%(Extension)' == '.dylib' Or '%(Extension)' == '.so')" />
    </ItemGroup>
  </Target>

</Project>
