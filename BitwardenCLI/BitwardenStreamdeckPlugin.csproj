<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>BitwardenStreamdeckPlugin</RootNamespace>
    <AssemblyName>com.thejoeiaut.bitwarden</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Bitwarden Stream Deck Plugin</Product>
    <AssemblyTitle>Bitwarden Stream Deck Plugin</AssemblyTitle>
    <Company>TheJoeIaut</Company>
    <Copyright>Copyright © TheJoeIaut</Copyright>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\com.thejoeiaut.bitwarden.sdPlugin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\com.thejoeiaut.bitwarden.sdPlugin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BitwardenCLI.Tests" />
    <!-- Lets NSubstitute's proxy generator mock the internal seams (IBwCli, IKeyboardTyper). -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="H.InputSimulator" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamDeck-Tools" Version="7.0.0" />
    <!-- SkiaSharp ships Windows and macOS natives by default; Linux needs this explicitly. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="previews\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="PropertyInspector\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- StreamDeck-Tools 7 pulls in SkiaSharp, whose native assets add ~240 MB of debug
       symbols (one libSkiaSharp.pdb per RID). Those are never needed at runtime on any
       platform, so keep them out of the .sdPlugin folder we ship. The actual native
       libraries are kept for every RID. Build and publish use separate item lists. -->
  <Target Name="RemoveUnusedSkiaNativeAssetsOnBuild" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'libSkiaSharp' And '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveUnusedSkiaNativeAssetsOnPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'libSkiaSharp' And '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
